// Copy to Secrets.xcconfig and fill in. Never commit Secrets.xcconfig.
BUNDLE_ID_PREFIX = com.yourname.moments
DEVELOPMENT_TEAM = ABCDE12345
SPOTIFY_CLIENT_ID = your-spotify-client-id
// Your deployed backend, e.g. https://moments-backend.<you>.workers.dev
BACKEND_URL = https:/$()/moments-backend.your-subdomain.workers.dev
// Must match the APP_TOKEN secret on the backend.
BACKEND_TOKEN = the-same-long-random-string
