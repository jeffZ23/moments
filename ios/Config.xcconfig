// Build settings for Moments. Put your own values in Secrets.xcconfig (gitignored),
// copied from Secrets.example.xcconfig. Note: "//" starts a comment in xcconfig files,
// so URLs are written as https:/$()/example.com
BUNDLE_ID_PREFIX = com.example.moments
DEVELOPMENT_TEAM =
SPOTIFY_CLIENT_ID =
BACKEND_URL =
BACKEND_TOKEN =

#include? "Secrets.xcconfig"
